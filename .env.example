# ── CineGram Configuration ──────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ── Telegram ────────────────────────────────────────────────────────────
BOT_TOKEN=
CHANNEL_ID=
ADMIN_ID=1332042587

# ── Media APIs ──────────────────────────────────────────────────────────
TMDB_API_KEY=
OMDB_API_KEY=
INSTAGRAM_URL=https://instagram.com

# ── Telegram Userbot (Telethon) ────────────────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ── AI Provider ─────────────────────────────────────────────────────────
# Options: auto | groq | ollama | none
#   auto  - Try Groq first, fallback to Ollama, then skip AI
#   groq  - Cloud AI only (recommended for Oracle Cloud)
#   ollama - Local AI only (requires Ollama running)
#   none  - Disable all AI features (fastest, no translation)
AI_PROVIDER=auto

# Groq (cloud) - free tier: no credit card needed
# Get key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local) - requires Ollama installed and running
OLLAMA_MODEL=dolphin-llama3:latest

# ── Access Control ──────────────────────────────────────────────────────
ACCESS_PASSWORD=cinegram123
